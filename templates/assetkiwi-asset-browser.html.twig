<div class="assetkiwi-browser layout-container">

  {% if api_error is defined and api_error %}
    <div class="assetkiwi-browser__error messages messages--error">
      <p>{{ 'Could not connect to Asset.Kiwi. Please check the connection settings.'|t }}</p>
      <p class="assetkiwi-browser__error-detail">{{ api_error }}</p>
    </div>
  {% elseif assets is empty and not filters.search and not filters.collection and not filters.tag and not filters.type %}
    {# Initial load with no filters — show loading state, not "no results" #}
    <div class="assetkiwi-browser__empty">
      <p>{{ 'Browse or search for assets from Asset.Kiwi.'|t }}</p>
    </div>
  {% endif %}

  <div class="assetkiwi-browser__filters views-exposed-form">
    <form method="get" action="" class="form--inline clearfix">

      <div class="form-item js-form-item form-type-search js-form-type-search">
        <label class="form-item__label" for="edit-search">{{ 'Search'|t }}</label>
        <input
          type="search"
          id="edit-search"
          name="search"
          value="{{ filters.search }}"
          placeholder="{{ 'Keywords…'|t }}"
          class="form-element form-element--type-search"
        />
      </div>

      {% if collections is not empty %}
        <div class="form-item js-form-item form-type-select js-form-type-select">
          <label class="form-item__label" for="edit-collection">{{ 'Collection'|t }}</label>
          <select id="edit-collection" name="collection" class="form-element form-element--type-select">
            <option value="">{{ '— Any —'|t }}</option>
            {% for collection in collections %}
              <option value="{{ collection.id }}" {% if filters.collection == collection.id %}selected{% endif %}>
                {{ collection.name }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endif %}

      {% if tags is not empty %}
      <div class="form-item js-form-item form-type-select js-form-type-select">
        <label class="form-item__label" for="edit-tag">{{ 'Tag'|t }}</label>
        <select id="edit-tag" name="tag" class="form-element form-element--type-select">
          <option value="">{{ '— Any —'|t }}</option>
          {% for tag in tags %}
            <option value="{{ tag.id }}" {% if filters.tag == tag.id %}selected{% endif %}>
              {{ tag.name }}
            </option>
          {% endfor %}
        </select>
      </div>
      {% endif %}

      {% if show_type_filter is not defined or show_type_filter %}
        {% set resolved_type_options = type_options is defined ? type_options : {
          'image': 'Images'|t,
          'video': 'Video'|t,
          'audio': 'Audio'|t,
          'document': 'Documents'|t
        } %}
        <div class="form-item js-form-item form-type-select js-form-type-select">
          <label class="form-item__label" for="edit-mime-type">{{ 'Type'|t }}</label>
          <select id="edit-mime-type" name="mime_type" class="form-element form-element--type-select">
            <option value="">{{ '— Any —'|t }}</option>
            {% for type_key, type_label in resolved_type_options %}
              <option value="{{ type_key }}" {% if filters.type == type_key %}selected{% endif %}>{{ type_label }}</option>
            {% endfor %}
          </select>
        </div>
      {% endif %}

      <div class="form-item js-form-item form-type-select js-form-type-select" id="edit-mode-wrapper">
        <label class="form-item__label" for="edit-mode">{{ 'Search mode'|t }}</label>
        <select id="edit-mode" name="mode" class="form-element form-element--type-select">
          <option value="" {% if filters.mode is not defined or not filters.mode %}selected{% endif %}>{{ 'Keyword'|t }}</option>
          <option value="semantic" {% if filters.mode == 'semantic' %}selected{% endif %}>{{ 'Semantic'|t }}</option>
          <option value="hybrid" {% if filters.mode == 'hybrid' %}selected{% endif %}>{{ 'Hybrid'|t }}</option>
        </select>
      </div>

      {% if allowed_types is defined and allowed_types is not empty %}
        <input type="hidden" name="allowed_types" value="{{ allowed_types|join(',') }}" />
      {% endif %}

      <div class="form-actions">
        <button type="submit" class="button button--primary">{{ 'Apply'|t }}</button>
        <a href="?" class="button">{{ 'Reset'|t }}</a>
      </div>

    </form>
  </div>{# /.assetkiwi-browser__filters #}

  <div class="assetkiwi-browser__summary">
    {% if pager.total > 0 %}
      {{ 'Showing @count of @total assets'|t({'@count': assets|length, '@total': pager.total}) }}
    {% else %}
      {{ 'No assets found.'|t }}
    {% endif %}
  </div>

  {% if assets is not empty %}
    <ul class="assetkiwi-browser__grid media-library-views-form__rows">
      {% for asset in assets %}
        {% set asset_uuid = asset.uuid ?? asset.id %}
        {% set asset_name = asset.original_name ?? asset.name ?? asset.filename ?? 'Untitled'|t %}
        {% set thumb_url = null %}
        {% if asset.variants is defined and asset.variants is iterable %}
          {% for variant in asset.variants %}
            {% if variant.variant_name == 'thumb' %}
              {% set thumb_url = variant.url %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% set asset_url = asset.url ?? asset.download_url %}
        {% set display_url = thumb_url ?? asset_url %}
        {% set asset_mime = asset.mime_type ?? asset.mimeType ?? '' %}

        <li class="assetkiwi-browser__card media-library-item">
          {% if cardinality is defined and cardinality != 1 %}
          <div class="assetkiwi-browser__card-select">
            <input type="checkbox" class="assetkiwi-browser__checkbox js-assetkiwi-select-multi"
                   data-uuid="{{ asset_uuid }}"
                   data-name="{{ asset_name }}"
                   data-mime="{{ asset_mime }}"
                   data-url="{{ asset_url }}" />
          </div>
          {% endif %}

          <div class="assetkiwi-browser__card-preview">
            {% if asset_mime starts with 'image' and display_url %}
              <img
                src="{{ display_url }}"
                alt="{{ asset.alt_text ?? asset_name }}"
                class="assetkiwi-browser__thumbnail"
                loading="lazy"
                data-full-url="{{ asset_url }}"
              />
            {% else %}
              <div class="assetkiwi-browser__file-icon">
                <span class="assetkiwi-browser__mime-label">{{ asset_mime ?: 'file'|t }}</span>
              </div>
            {% endif %}
          </div>

          <div class="assetkiwi-browser__card-body">
            <p class="assetkiwi-browser__asset-name" title="{{ asset_name }}">
              {{ asset_name|length > 40 ? asset_name|slice(0, 37) ~ '…' : asset_name }}
            </p>
            {% if asset.size %}
              <p class="assetkiwi-browser__asset-meta">
                {{ asset.size|number_format }} {{ 'bytes'|t }}
              </p>
            {% endif %}
            {% if asset.width is defined and asset.height is defined %}
              <p class="assetkiwi-browser__asset-meta">{{ asset.width }} × {{ asset.height }}</p>
            {% endif %}
            <p class="assetkiwi-browser__asset-mime">{{ asset_mime }}</p>
          </div>

          <div class="assetkiwi-browser__card-actions">
            <button
              type="button"
              class="button button--small assetkiwi-browser__select-btn js-assetkiwi-select"
              data-uuid="{{ asset_uuid }}"
              data-name="{{ asset_name }}"
              data-mime="{{ asset_mime }}"
              data-url="{{ asset_url }}"
            >
              {{ 'Select'|t }}
            </button>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="assetkiwi-browser__empty messages messages--warning">
      <p>{{ 'No assets match your current filters.'|t }}</p>
    </div>
  {% endif %}

  {% if pager.last_page > 1 %}
    <div class="assetkiwi-browser__page-size">
      <label for="edit-per-page">{{ 'Per page'|t }}</label>
      <select id="edit-per-page" class="form-element form-element--type-select assetkiwi-browser__per-page">
        <option value="12" {% if filters.per_page == 12 %}selected{% endif %}>12</option>
        <option value="24" {% if filters.per_page == 24 or not filters.per_page %}selected{% endif %}>24</option>
        <option value="48" {% if filters.per_page == 48 %}selected{% endif %}>48</option>
        <option value="96" {% if filters.per_page == 96 %}selected{% endif %}>96</option>
      </select>
    </div>

    <nav class="assetkiwi-browser__pager pager" aria-label="{{ 'Pagination'|t }}">
      <ul class="pager__items">

        {% if pager.current_page > 1 %}
          <li class="pager__item pager__item--previous">
            <a href="?{{ filters|merge({'page': pager.current_page - 1})|url_encode }}" class="pager__link" rel="prev">
              <span aria-hidden="true">‹</span> {{ 'Previous'|t }}
            </a>
          </li>
        {% endif %}

        {% for p in 1..pager.last_page %}
          {% if p == pager.current_page %}
            <li class="pager__item is-active">
              <span class="pager__link" aria-current="page">{{ p }}</span>
            </li>
          {% elseif p == 1 or p == pager.last_page or (p >= pager.current_page - 2 and p <= pager.current_page + 2) %}
            <li class="pager__item">
              <a href="?{{ filters|merge({'page': p})|url_encode }}" class="pager__link">{{ p }}</a>
            </li>
          {% elseif p == pager.current_page - 3 or p == pager.current_page + 3 %}
            <li class="pager__item pager__item--ellipsis" aria-hidden="true">
              <span class="pager__link">…</span>
            </li>
          {% endif %}
        {% endfor %}

        {% if pager.current_page < pager.last_page %}
          <li class="pager__item pager__item--next">
            <a href="?{{ filters|merge({'page': pager.current_page + 1})|url_encode }}" class="pager__link" rel="next">
              {{ 'Next'|t }} <span aria-hidden="true">›</span>
            </a>
          </li>
        {% endif %}

      </ul>
    </nav>
  {% endif %}

{% if cardinality is defined and cardinality != 1 %}
  <div class="assetkiwi-browser__multiselect-toolbar" style="display:none">
    <span class="assetkiwi-browser__selected-count">0</span> {{ 'selected'|t }}
    <button type="button" class="button button--primary js-assetkiwi-import-selected">{{ 'Import selected'|t }}</button>
  </div>
{% endif %}

</div>{# /.assetkiwi-browser #}
